<Project Sdk="Microsoft.NET.Sdk">

  <!-- Engine-free game logic (STR-02, INV-01): no Godot reference, ever. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MistyInn.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MistyInn.Core.Tests" />
  </ItemGroup>

  <!--
    The committed data/*.json files, built in as the fallback content and the tests' content (DAT-02, DAT-04).
    Resource names are MistyInn.Data.<file name>.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\*.json" LogicalName="MistyInn.Data.%(Filename)%(Extension)" Link="Data\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
